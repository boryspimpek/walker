<?xml version="1.0" ?>
<robot name="Walker" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find Walker_description)/urdf/materials.xacro" />
<xacro:include filename="$(find Walker_description)/urdf/Walker.trans" />
<xacro:include filename="$(find Walker_description)/urdf/Walker.gazebo" />

# wymiary są podane obok nazwy linku, jointy są umiejscowione z boku elementu 10mm od krawędzi
<link name="base_link"> # 30/30/40
  <inertial>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <mass value="0.2792706971853582"/>
    <inertia ixx="5.8e-05" iyy="5.9e-05" izz="4.2e-05" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="thigh_1"> # 30/30/100
  <inertial>
    <origin xyz="0 -0.015 -0.04" rpy="0 0 0"/>
    <mass value="0.7031706971853583"/>
    <inertia ixx="0.000636" iyy="0.000636" izz="0.000106" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.015 0.03" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/thigh_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.015 0.03" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/thigh_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="knee"> # 30/30/40
  <inertial>
    <origin xyz="0 -0.015 -0.01" rpy="0 0 0"/>
    <mass value="0.27927069718535813"/>
    <inertia ixx="5.8e-05" iyy="5.9e-05" izz="4.2e-05" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.015 0.11" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/foot_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.015 0.11" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/foot_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="shin"> #30/30/100
  <inertial>
    <origin xyz="0 -0.015 -0.04" rpy="0 0 0"/>
    <mass value="0.7031706971853583"/>
    <inertia ixx="0.000636" iyy="0.000636" izz="0.000106" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.015 0.13" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/knee_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.015 0.13" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/knee_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="foot"> # 30/30/40
  <inertial>
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <mass value="0.27927069718535813"/>
    <inertia ixx="5.8e-05" iyy="5.9e-05" izz="4.2e-05" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.015 0.21" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/shin_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.015 0.21" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/shin_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Revolute 107" type="continuous">
  <origin xyz="0.0 0.015 -0.03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="thigh_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute 108" type="continuous">
  <origin xyz="0.0 0.0 -0.08" rpy="0 0 0"/>
  <parent link="thigh_1"/>
  <child link="knee"/>
  <axis xyz="-0.0 1.0 -0.0"/>
</joint>

<joint name="Revolute 109" type="continuous">
  <origin xyz="0.0 0.0 -0.02" rpy="0 0 0"/>
  <parent link="knee"/>
  <child link="shin"/>
  <axis xyz="0.0 1.0 -0.0"/>
</joint>

<joint name="Revolute 110" type="continuous">
  <origin xyz="0.0 0.0 -0.08" rpy="0 0 0"/>
  <parent link="shin"/>
  <child link="foot"/>
  <axis xyz="0.0 1.0 -0.0"/>
</joint>

</robot>
