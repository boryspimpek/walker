<joint name="Revolute 107" type="continuous">
  <origin xyz="0.0 0.015 -0.03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="thigh_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute 108" type="continuous">
  <origin xyz="0.0 0.0 -0.08" rpy="0 0 0"/>
  <parent link="thigh_1"/>
  <child link="foot_1"/>
  <axis xyz="-0.0 1.0 -0.0"/>
</joint>

<joint name="Revolute 109" type="continuous">
  <origin xyz="0.0 0.0 -0.02" rpy="0 0 0"/>
