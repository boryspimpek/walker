    <origin xyz="-1.6853903352155879e-15 -0.014999999999999984 -0.009999999999999593" rpy="0 0 0"/>
    <mass value="0.27927069718535813"/>
    <inertia ixx="5.8e-05" iyy="5.9e-05" izz="4.2e-05" ixy="0.0" iyz="-0.0" ixz="0.0"/>
