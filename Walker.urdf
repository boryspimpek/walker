<joint name="Revolute 110" type="continuous">
  <origin xyz="0.0 0.0 -0.08" rpy="0 0 0"/>
  <parent link="knee_1"/>
  <child link="shin_1"/>
  <axis xyz="0.0 1.0 -0.0"/>
