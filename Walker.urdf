<link name="knee_1">
  <inertial>
    <origin xyz="-2.4198695768984886e-16 -0.014999999999999927 -0.0399999999999999" rpy="0 0 0"/>
    <mass value="0.7031706971853583"/>
    <inertia ixx="0.000636" iyy="0.000636" izz="0.000106" ixy="0.0" iyz="0.0" ixz="0.0"/>
