<?xml version="1.0" ?>
<robot name="Walker" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find Walker_description)/urdf/materials.xacro" />
<xacro:include filename="$(find Walker_description)/urdf/Walker.trans" />
<xacro:include filename="$(find Walker_description)/urdf/Walker.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.0 0.0 -0.019940746103482097" rpy="0 0 0"/>
    <mass value="0.28093534859267927"/>
    <inertia ixx="5.9e-05" iyy="5.9e-05" izz="4.2e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

