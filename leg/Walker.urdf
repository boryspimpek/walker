  </visual>
  <collision>
    <origin xyz="-0.0 0.0 0.28" rpy="0 0 0"/>
    <geometry>
      <mesh filename="leg/Walker_description/meshes/foot_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="hip_roll" type="continuous">
  <origin xyz="0.015 0.0 -0.03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="hip_roll_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <!-- <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/> -->
</joint>

<joint name="hip_pitch" type="continuous">
  <origin xyz="-0.015 0.015 -0.02" rpy="0 0 0"/>
  <parent link="hip_roll_1"/>
  <child link="thigh_1"/>
  <axis xyz="-0.0 -1.0 0.0"/>
  <!-- <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/> -->
</joint>

<joint name="knee_pitch1" type="continuous">
  <origin xyz="0.0 0.0 -0.08" rpy="0 0 0"/>
  <parent link="thigh_1"/>
  <child link="knee_1"/>
  <axis xyz="-0.0 1.0 -0.0"/>
  <!-- <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/> -->
</joint>

<joint name="knee_pitch2" type="continuous">
  <origin xyz="0.0 0.0 -0.02" rpy="0 0 0"/>
  <parent link="knee_1"/>
  <child link="shin_1"/>
  <axis xyz="0.0 1.0 -0.0"/>
  <!-- <limit lower="0" upper="1.57" effort="100" velocity="1.0"/> -->
</joint>

<joint name="ankle_pitch" type="continuous">
  <origin xyz="0.0 0.0 -0.08" rpy="0 0 0"/>
  <parent link="shin_1"/>
  <child link="ankle_1"/>
  <axis xyz="0.0 1.0 -0.0"/>
  <!-- <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/> -->
</joint>

<joint name="ankle_roll" type="continuous">
  <origin xyz="0.015 -0.015 -0.02" rpy="0 0 0"/>
  <parent link="ankle_1"/>
  <child link="ankle_roll_1"/>
  <axis xyz="1.0 -0.0 0.0"/>
  <!-- <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/> -->
</joint>

<joint name="Rigid 120" type="fixed">
  <origin xyz="-0.015 0.0 -0.03" rpy="0 0 0"/>
  <parent link="ankle_roll_1"/>
  <child link="foot_1"/>
</joint>

</robot>
