  <inertial>
    <origin xyz="5.248353906337566e-09 -0.014999999999999809 -0.03999998244649275" rpy="0 0 0"/>
    <mass value="0.7031704499676481"/>
    <inertia ixx="0.000636" iyy="0.000636" izz="0.000106" ixy="0.0" iyz="-0.0" ixz="0.0"/>
