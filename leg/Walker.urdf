<link name="foot_1">
  <inertial>
    <origin xyz="6.245004505575571e-16 -2.76128590171539e-16 -0.004999999999999394" rpy="0 0 0"/>
    <mass value="0.5024"/>
    <inertia ixx="0.000272" iyy="0.000272" izz="0.000536" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 0.0 0.28" rpy="0 0 0"/>
