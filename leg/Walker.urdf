    <inertia ixx="5.8e-05" iyy="5.8e-05" izz="4.2e-05" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.015 0.23" rpy="0 0 0"/>
    <geometry>
