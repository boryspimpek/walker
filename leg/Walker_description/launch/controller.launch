<launch>

<rosparam file="$(find Walker_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="Walker" args="hip_position_controller knee_1_position_controller knee_2_position_controller ankle_position_controller Revolute 112_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/Walker/joint_states"/>
</node>

</launch>