<launch>

<rosparam file="$(find Walker_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="Walker" args="hip_roll_position_controller hip_pitch_position_controller knee_pitch1_position_controller knee_pitch2_position_controller ankle_pitch_position_controller ankle_roll_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/Walker/joint_states"/>
</node>

</launch>