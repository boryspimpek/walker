<joint name="hip" type="continuous">
  <origin xyz="0.0 0.015 -0.03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="thigh_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="knee_1" type="continuous">
  <origin xyz="0.0 0.0 -0.08" rpy="0 0 0"/>
  <parent link="thigh_1"/>
  <child link="knee_1"/>
  <axis xyz="-0.0 1.0 -0.0"/>
</joint>

<joint name="knee_2" type="continuous">
  <origin xyz="0.0 0.0 -0.02" rpy="0 0 0"/>
  <parent link="knee_1"/>
  <child link="shin_1"/>
  <axis xyz="0.0 1.0 -0.0"/>
</joint>

<joint name="ankle" type="continuous">
  <origin xyz="0.0 0.0 -0.08" rpy="0 0 0"/>
  <parent link="shin_1"/>
  <child link="ankle_1"/>
  <axis xyz="0.0 1.0 -0.0"/>
</joint>

<joint name="Revolute 112" type="continuous">
  <origin xyz="0.015 -0.015 -0.02" rpy="0 0 0"/>
  <parent link="ankle_1"/>
  <child link="ankle_roll_1"/>
  <axis xyz="1.0 -0.0 0.0"/>
</joint>

<joint name="Rigid 113" type="fixed">
  <origin xyz="-0.015 0.0 -0.03" rpy="0 0 0"/>
  <parent link="ankle_roll_1"/>
  <child link="foot_1"/>
</joint>

</robot>
