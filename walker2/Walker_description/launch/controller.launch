<launch>

<rosparam file="$(find Walker_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="Walker" args="Revolute 32_position_controller Revolute 33_position_controller Revolute 34_position_controller Revolute 35_position_controller Revolute 36_position_controller Revolute 39_position_controller Revolute 40_position_controller Revolute 41_position_controller Revolute 42_position_controller Revolute 43_position_controller Revolute 46_position_controller Revolute 47_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/Walker/joint_states"/>
</node>

</launch>