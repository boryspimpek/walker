import numpy as np

def inverse_kinematics_3dof(x, y, z, l1, l2, l3):
    """
    Inverse kinematics dla 3DOF nogi robota psa.
    
    Parametry:
    - x, y, z: docelowa pozycja końcówki nogi (stopa)
    - l1: długość segmentu hip (od osi roll do osi pitch)
    - l2: długość uda (od hip pitch do knee pitch)
    - l3: długość goleni (od knee pitch do stopy)
    
    Zwraca:
    - hip_roll: kąt obrotu biodra wokół osi X (radiany)
    - hip_pitch: kąt zgięcia biodra wokół osi Y (radiany)
    - knee_pitch: kąt zgięcia kolana wokół osi Y (radiany)
    """
    
    # Krok 1: Oblicz hip_roll (obrót wokół osi X)
    # Hip roll kompensuje przesunięcie boczne (y) i offset l1
    hip_roll = np.arctan2(y, z)
    
    # Krok 2: Oblicz odległość od osi hip pitch do celu w płaszczyźnie YZ
    d_yz = np.sqrt(y**2 + z**2)
    
    # Krok 3: Skoryguj o offset l1 (odległość od hip roll do hip pitch)
    # Po obrocie hip_roll, efektywna odległość w płaszczyźnie prostopadłej to:
    d_corrected = d_yz
    
    # Krok 4: Oblicz odległość w płaszczyźnie XZ' (gdzie Z' to oś po korekcie)
    # To jest płaszczyzna w której działają hip_pitch i knee_pitch
    r = np.sqrt(x**2 + d_corrected**2)
    
    # Krok 5: Zastosuj prawo cosinusów dla trójkąta utworzonego przez l2, l3 i r
    # Oblicz kąt w kolanie
    cos_knee = (l2**2 + l3**2 - r**2) / (2 * l2 * l3)
    
    # Sprawdź czy rozwiązanie istnieje
    if cos_knee < -1 or cos_knee > 1:
        raise ValueError(f"Pozycja ({x}, {y}, {z}) jest poza zasięgiem nogi")
    
    # Kąt kolana (ujemny bo kolano zgina się "do tyłu" jak u psa)
    knee_pitch = -(np.pi - np.arccos(cos_knee))
    
    # Krok 6: Oblicz hip_pitch
    # Kąt do punktu docelowego względem poziomu
    alpha = np.arctan2(-d_corrected, x)
    
    # Kąt w biodrze z prawa cosinusów
    cos_beta = (l2**2 + r**2 - l3**2) / (2 * l2 * r)
    beta = np.arccos(np.clip(cos_beta, -1, 1))
    
    # Hip pitch to suma/różnica tych kątów
    hip_pitch = alpha + beta
    
    return hip_roll, hip_pitch, knee_pitch


# Przykład użycia
if __name__ == "__main__":
    # Przykładowe długości segmentów (w metrach lub jednostkach robota)
    l1 = 0.044  # offset hip (roll -> pitch)
    l2 = 0.067  # długość uda
    l3 = 0.067  # długość goleni
    
    # Docelowa pozycja stopy
    x_target = 0.0   # do przodu
    y_target = 0.0   # na bok
    z_target = 0.134  # w dół
    
    try:
        hip_roll, hip_pitch, knee_pitch = inverse_kinematics_3dof(
            x_target, y_target, z_target, l1, l2, l3
        )
        
        print("Obliczone kąty stawów:")
        print(f"Hip Roll:  {np.degrees(hip_roll):.2f}°")
        print(f"Hip Pitch: {np.degrees(hip_pitch):.2f}°")
        print(f"Knee Pitch: {np.degrees(knee_pitch):.2f}°")
        
    except ValueError as e:
        print(f"Błąd: {e}")