import math
import numpy as np

def inverse_kinematics_3dof(x, y, z, l1, l2, l3):
    hip_roll = np.arctan2(y, z)
    
    D = np.sqrt(y**2 + z**2)
    print(f"D: {D:.5f}")
    
    r = np.sqrt(x**2 + (D-l1)**2)
    print(f"r: {r:.5f}")
    
    cos_knee = (l2**2 + l3**2 - r**2) / (2 * l2 * l3)
    
    if cos_knee < -1 or cos_knee > 1:
        raise ValueError(f"Pozycja ({x}, {y}, {z}) jest poza zasięgiem nogi")
    
    knee_pitch = np.pi - np.arccos(cos_knee)
    alpha = np.arctan2(x, (D-l1))
    print(f"alpha: {np.degrees(alpha):.3f}°")
    cos_beta = (l2**2 + r**2 - l3**2) / (2 * l2 * r)
    beta = np.arccos(np.clip(cos_beta, -1, 1))
    print(f"beta: {np.degrees(beta):.3f}°")
    hip_pitch = alpha + beta

    return hip_roll, hip_pitch, knee_pitch


# Przykład użycia
if __name__ == "__main__":
    # Przykładowe długości segmentów (w metrach lub jednostkach robota)
    l1 = 0.04  # offset hip (roll -> pitch)
    l2 = 0.067  # długość uda
    l3 = 0.067  # długość goleni
    
    # Docelowa pozycja stopy
    x_target = 0.02   # do przodu
    y_target = 0.08  # na bok
    z_target = 0.11  # w dół
    
    try:
        hip_roll, hip_pitch, knee_pitch = inverse_kinematics_3dof(
            x_target, y_target, z_target, l1, l2, l3
        )
        
        print("Obliczone kąty stawów:")
        print(f"Hip Roll:  {np.degrees(hip_roll):.2f}°")
        print(f"Hip Pitch: {np.degrees(hip_pitch):.2f}°")
        print(f"Knee Pitch: {np.degrees(knee_pitch):.2f}°")
        
    except ValueError as e:
        print(f"Błąd: {e}")